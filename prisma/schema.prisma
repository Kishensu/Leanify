generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaxonomyLevel {
  category
  group
  process
  activity
  task
}

model Taxonomy {
  pcfId             Int           @id @map("pcf_id")
  hierarchyId       String        @unique @map("hierarchy_id")
  level             TaxonomyLevel
  name              String
  parentHierarchyId String?       @map("parent_hierarchy_id")
  description       String

  processes  Process[]
  activities ProcessActivity[]

  @@index([parentHierarchyId])
  @@index([level])
  @@map("taxonomy")
}

model Process {
  id              String   @id @default(cuid())
  name            String
  apqcHierarchyId String   @map("apqc_hierarchy_id")
  ownerTeam       String   @map("owner_team")
  description     String
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// Set only for processes generated by the seed script (1:1 with a taxonomy
  /// process-level node), used as its idempotency key. Null for processes
  /// created through the Add Process wizard, which file under a group and may
  /// share apqcHierarchyId with sibling custom processes.
  sourcePcfId     Int?     @unique @map("source_pcf_id")

  taxonomy Taxonomy @relation(fields: [apqcHierarchyId], references: [hierarchyId])

  kpiMetrics           KpiMetric[]
  controlTowerMetrics  ControlTowerMetric[]
  reactionPlans        ReactionPlan[]
  activities           ProcessActivity[]
  diagrams             ProcessDiagram[]

  @@index([apqcHierarchyId])
  @@index([ownerTeam])
  @@map("processes")
}

model KpiMetric {
  id          String  @id @default(cuid())
  processId   String  @map("process_id")
  metricName  String  @map("metric_name")
  value       Float
  unit        String
  targetValue Float   @map("target_value")

  process  Process           @relation(fields: [processId], references: [id], onDelete: Cascade)
  readings KpiMetricReading[]

  @@index([processId])
  @@map("kpi_metrics")
}

/// Historical points backing the Process Performance tab's trend chart.
model KpiMetricReading {
  id          String   @id @default(cuid())
  kpiMetricId String   @map("kpi_metric_id")
  periodLabel String   @map("period_label")
  value       Float
  recordedAt  DateTime @map("recorded_at")

  kpiMetric KpiMetric @relation(fields: [kpiMetricId], references: [id], onDelete: Cascade)

  @@index([kpiMetricId])
  @@map("kpi_metric_readings")
}

model ControlTowerMetric {
  id         String  @id @default(cuid())
  processId  String  @map("process_id")
  metricName String  @map("metric_name")
  value      Float
  ucl        Float
  lcl        Float?
  /// Inner "Watch" zone thresholds — tighter than the hard ucl/lcl. Null means
  /// this metric has no watch zone (only in-control/breach).
  warningUcl Float? @map("warning_ucl")
  warningLcl Float? @map("warning_lcl")

  /// Set when this metric monitors a specific activity rather than the whole process.
  processActivityId String? @map("process_activity_id")

  measurementMethod  String? @map("measurement_method")
  responsibleRole    String? @map("responsible_role")
  reviewFrequency    String? @map("review_frequency")
  triggerDescription String? @map("trigger_description")

  process         Process          @relation(fields: [processId], references: [id], onDelete: Cascade)
  processActivity ProcessActivity? @relation(fields: [processActivityId], references: [id], onDelete: SetNull)
  reactionPlan    ReactionPlan?
  readings        ControlMetricReading[]

  @@unique([processId, metricName])
  @@index([processActivityId])
  @@map("control_tower_metrics")
}

/// Historical points backing the Control Tower tab's SPC chart.
model ControlMetricReading {
  id                   String   @id @default(cuid())
  controlTowerMetricId String   @map("control_tower_metric_id")
  sequenceIndex        Int      @map("sequence_index")
  value                Float
  recordedAt           DateTime @map("recorded_at")

  controlTowerMetric ControlTowerMetric @relation(fields: [controlTowerMetricId], references: [id], onDelete: Cascade)

  @@index([controlTowerMetricId])
  @@map("control_metric_readings")
}

/// One step in a reaction plan. Stored as a JSON array on ReactionPlan.steps.
/// (Documented here for reference — Prisma doesn't have a first-class type for
/// "array of objects" in Postgres short of a composite type.)
/// type ReactionStep = { text: string; automated: boolean }
model ReactionPlan {
  id                 String   @id @default(cuid())
  processId          String   @map("process_id")
  controlTowerMetricId String @unique @map("control_tower_metric_id")
  /// ReactionStep[] — see the note above the model.
  steps              Json
  notifyRole         String   @map("notify_role")
  escalationTrigger  String   @map("escalation_trigger")

  process            Process            @relation(fields: [processId], references: [id], onDelete: Cascade)
  controlTowerMetric ControlTowerMetric @relation(fields: [controlTowerMetricId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("reaction_plans")
}

model LssTool {
  id             String @id @default(cuid())
  name           String
  icon           String
  promptTemplate String @map("prompt_template")

  @@map("lss_tools")
}

/// Drives which real BPMN 2.0 element gets generated — see the mapping table
/// in src/lib/bpmn.ts. Not decorative: the diagram is wrong without it.
enum ElementType {
  user_task
  system_task
  decision_task
  approval_gateway
  parallel_gateway
  timer_event
  manual_task
  start_event
  end_event
}

model ProcessActivity {
  id               String      @id @default(cuid())
  processId        String      @map("process_id")
  /// Nested grouping (task under an activity) — orthogonal to branching below.
  parentActivityId String?     @map("parent_activity_id")
  sequenceOrder    Int         @map("sequence_order")
  name             String
  apqcHierarchyId  String?     @map("apqc_hierarchy_id")
  elementType      ElementType @default(user_task)

  /// Required when elementType is user_task: who reviews/approves.
  approverRole String? @map("approver_role")
  /// Required when elementType is system_task: which system executes it.
  systemRef    String? @map("system_ref")
  /// Required when elementType is decision_task: the DMN decision table name,
  /// becomes camunda:decisionRef on the generated businessRuleTask.
  decisionRef  String? @map("decision_ref")
  /// Required when elementType is approval_gateway: exactly 2 entries, one per
  /// outgoing branch (e.g. ["Approved", "Rejected"]).
  branchLabels String[] @map("branch_labels")

  /// Set on the first node of a branch following an approval_gateway — points
  /// at that gateway. Nodes with this null continue the primary flow in
  /// sequenceOrder; nodes with it set start a named branch instead.
  branchOfId String?  @map("branch_of_id")
  /// Required alongside branchOfId: which of the gateway's branchLabels this
  /// node continues.
  branchLabel String? @map("branch_label")

  process        Process           @relation(fields: [processId], references: [id], onDelete: Cascade)
  parentActivity ProcessActivity?  @relation("ActivityToTask", fields: [parentActivityId], references: [id], onDelete: Cascade)
  tasks          ProcessActivity[] @relation("ActivityToTask")
  taxonomy       Taxonomy?         @relation(fields: [apqcHierarchyId], references: [hierarchyId])
  branchOf       ProcessActivity?  @relation("GatewayToBranch", fields: [branchOfId], references: [id], onDelete: Cascade)
  branches       ProcessActivity[] @relation("GatewayToBranch")
  controlTowerMetrics ControlTowerMetric[]

  @@index([processId])
  @@index([parentActivityId])
  @@index([branchOfId])
  @@map("process_activities")
}

model ProcessDiagram {
  id             String   @id @default(cuid())
  processId      String   @map("process_id")
  bpmnXml        String   @map("bpmn_xml")
  generatedAt    DateTime @default(now()) @map("generated_at")
  generatedFrom  String   @map("generated_from")
  /// True once a person has hand-edited this diagram in the Modeler and saved.
  /// A later regenerate must not silently overwrite it without confirmation.
  editedByUser   Boolean  @default(false) @map("edited_by_user")

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("process_diagrams")
}
